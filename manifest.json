{
    "schema_version": "45D_AP_V2.0",
    "name": "ceph-ansible-45d",
    "title": "Ceph Ansible",
    "stable": false,
    "version": "5.4.7",
    "build_number": "2",
    "author": "Brett Kelly <bkelly@45drives.com>",
    "git_url": "https://github.com/45Drives/ceph-ansible",
    "license": "GPL-3.0+",
    "architecture": {
        "ubuntu": "all",
        "rocky": "noarch"
    },
    "description": "Ansible playbooks to deploy Ceph with 45Drives-specific changes.",
    "defaults": {
        "urgency": "medium"
    },
    "dependencies": {
        "ubuntu_common": [
            "ansible",
            "ansible-core",
            "python3-netaddr",
            "python3",
            "samba-ansible (>= 1.1.3)"
        ],
        "rocky_common": [
            "ansible = 5.6.0",
            "ansible-core = 2.12.2",
            "python3",
            "python38-netaddr",
            "python38-pyyaml",
            "python38-six",
            "samba-ansible >= 1.1.3"
        ]
    },
    "builds": [
        {
            "image": "ci.cr.45d.io/ci/simple/ubuntu-focal:1",
            "os_name": "ubuntu-focal",
            "group": "ubuntu"
        },
        {
            "image": "ci.cr.45d.io/ci/simple/rocky-el8:1",
            "os_name": "rocky-el8",
            "group": "rocky"
        }
    ],
    "repos": [
        "community",
        "enterprise"
    ],
    "changelog": {
        "urgency": "medium",
        "version": "5.4.7",
        "buildVersion": "1",
        "ignore": [],
